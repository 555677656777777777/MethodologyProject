<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AutoVault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    @{
        var userName = Context.Session.GetString("UserName");
        var userRole = Context.Session.GetString("UserRole");
        bool isLoggedIn = !string.IsNullOrEmpty(userName);
        bool isAdmin = userRole == "Admin";
    }

    <!-- ═══ NAVBAR ═══ -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top av-navbar">
        <div class="container">
            <a class="navbar-brand av-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-car-front-fill av-brand-icon"></i>
                AutoVault
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Browse Cars
                        </a>
                    </li>
                    @if (isLoggedIn && !isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Offer" asp-action="MyOffers">
                                <i class="bi bi-clipboard-check me-1"></i>My Offers
                            </a>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CarAdmin" asp-action="Index">
                                <i class="bi bi-gear me-1"></i>Manage Cars
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Offer" asp-action="AllOffers">
                                <i class="bi bi-bar-chart me-1"></i>All Offers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="UserAdmin" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Users
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            <span class="nav-link disabled av-user-badge">
                                <span class="av-avatar">@userName[0]</span>
                                @userName
                                <span class="badge rounded-pill @(isAdmin ? "bg-info" : "bg-purple")">@userRole</span>
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm av-btn-accent ms-2 mt-1" asp-controller="Account" asp-action="Register">
                                Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ═══ MAIN CONTENT ═══ -->
    <main class="av-main">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert av-alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert av-alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <!-- ═══ FOOTER ═══ -->
    <footer class="av-footer">
        <div class="container text-center">
            <p class="mb-0">&copy; 2024 AutoVault Car Dealership. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
