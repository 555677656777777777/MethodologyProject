@model List<Car>

<div class="av-page-header av-animate">
    <h1><i class="bi bi-gear me-2"></i>Manage Cars</h1>
    <p>Add, edit, or remove vehicles from inventory</p>
</div>

<div class="d-flex justify-content-end mb-4 av-animate">
    <a asp-action="Create" class="btn av-btn-accent">
        <i class="bi bi-plus-lg me-1"></i> Add New Car
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="av-empty av-animate">
        <i class="bi bi-car-front"></i>
        <p>No cars in inventory yet.</p>
    </div>
}
else
{
    <div class="av-table av-animate">
        <table class="table table-dark table-borderless mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Brand</th>
                    <th>Model</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>#@car.Id</td>
                        <td><strong>@car.Brand</strong></td>
                        <td>@car.Model</td>
                        <td>@car.Year</td>
                        <td>$@car.Price.ToString("N0")</td>
                        <td>
                            <span class="av-badge @(car.IsAvailable ? "av-badge-available" : "av-badge-sold")">
                                @(car.IsAvailable ? "Available" : "Sold")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@car.Id"
                               class="btn av-btn-outline btn-sm me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@car.Id" method="post"
                                  class="d-inline" onsubmit="return confirm('Delete this car?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
