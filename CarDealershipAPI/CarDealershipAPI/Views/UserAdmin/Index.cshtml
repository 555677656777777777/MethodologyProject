@model List<UserDto>

<div class="av-page-header av-animate">
    <h1><i class="bi bi-people me-2"></i>User Management</h1>
    <p>View all registered users, ban or unban accounts</p>
</div>

@if (Model.Count == 0)
{
    <div class="av-empty av-animate">
        <i class="bi bi-people"></i>
        <p>No users found.</p>
    </div>
}
else
{
    <div class="av-table av-animate">
        <table class="table table-dark table-borderless mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>#@user.Id</td>
                        <td><strong>@user.Name</strong></td>
                        <td>@user.Email</td>
                        <td>
                            <span class="av-badge @(user.Role == "Admin" ? "av-badge-admin" : "av-badge-customer")">
                                @user.Role
                            </span>
                        </td>
                        <td>
                            <span class="av-badge @(user.IsBanned ? "av-badge-banned" : "av-badge-active")">
                                @(user.IsBanned ? "Banned" : "Active")
                            </span>
                        </td>
                        <td>
                            @if (user.Role != "Admin")
                            {
                                @if (user.IsBanned)
                                {
                                    <form asp-action="Unban" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-unlock"></i> Unban
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Ban" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Ban this user?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-lock"></i> Ban
                                        </button>
                                    </form>
                                }

                                <a asp-action="Details" asp-route-id="@user.Id" class="btn av-btn-outline btn-sm ms-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                            }
                            else
                            {
                                <span style="color:var(--av-muted)">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
