@model UserDto

<div class="row justify-content-center">
    <div class="col-lg-6">
        <a asp-action="Index" class="btn av-btn-outline btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Users
        </a>

        <div class="av-card av-animate">
            <div class="text-center mb-4">
                <div class="av-avatar mx-auto mb-3" style="width:64px;height:64px;font-size:1.5rem">
                    @Model.Name[0]
                </div>
                <h3 style="font-weight:700">@Model.Name</h3>
                <p style="color:var(--av-muted)">@Model.Email</p>
            </div>

            <div class="d-flex justify-content-center gap-3 mb-4">
                <span class="av-badge @(Model.Role == "Admin" ? "av-badge-admin" : "av-badge-customer")">
                    @Model.Role
                </span>
                <span class="av-badge @(Model.IsBanned ? "av-badge-banned" : "av-badge-active")">
                    @(Model.IsBanned ? "Banned" : "Active")
                </span>
            </div>

            @if (Model.Role != "Admin")
            {
                <div class="text-center">
                    @if (Model.IsBanned)
                    {
                        <form asp-action="Unban" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success">
                                <i class="bi bi-unlock me-1"></i> Unban User
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Ban" asp-route-id="@Model.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Ban this user?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-warning">
                                <i class="bi bi-lock me-1"></i> Ban User
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>
