@model Car

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-controller="Home" asp-action="Index" class="btn av-btn-outline btn-sm mb-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Cars
        </a>

        <div class="av-card av-animate">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="av-car-brand mb-0" style="font-size:2rem">@Model.Brand</h2>
                    <div class="av-car-model" style="font-size:1.1rem">@Model.Model</div>
                </div>
                <span class="av-car-year" style="font-size:0.9rem">@Model.Year</span>
            </div>

            <div class="av-car-price mb-3" style="font-size:2.2rem">$@Model.Price.ToString("N0")</div>

            <span class="av-badge @(Model.IsAvailable ? "av-badge-available" : "av-badge-sold") mb-4 d-inline-block">
                @(Model.IsAvailable ? "● Available" : "● Sold")
            </span>

            @{
                var role = Context.Session.GetString("UserRole");
            }
            @if (Model.IsAvailable && role == "Customer")
            {
                <div class="mt-4">
                    <a asp-controller="Offer" asp-action="Create" asp-route-id="@Model.Id"
                       class="btn av-btn-accent">
                        <i class="bi bi-cash-coin me-1"></i> Make an Offer
                    </a>
                </div>
            }
        </div>
    </div>
</div>
